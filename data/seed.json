  "events": [],
  "pages": [
    {
      "id": "page-bienvenue",
      "categorie": "presentation",
      "titre": "Bienvenue au Moulin Vert",
      "ordre": 1,
      "publie": true,
      "corps": "Bienvenue dans le cercle celtique Korriganed Ar Meilhoù Glas.\n\nNous représentons le quartier du Moulin Vert à Quimper et promouvons la culture bretonne à travers la danse, les costumes traditionnels et la musique. Au cercle, des crêpières partagent aussi leurs techniques lors des événements.\n\nIl existe plusieurs types de cercles celtiques : non adhérents, non classés adhérents à Kenleur, et classés adhérents à Kenleur. Des cercles bretons existent partout en France et dans le monde ; beaucoup viennent en Bretagne en été pour les concours.",
      "medias": [],
      "createdAt": "2026-08-01T10:00:00.000Z",
      "updatedAt": "2026-08-01T10:00:00.000Z"
    },
    {
      "id": "page-kenlieur",
      "categorie": "presentation",
      "titre": "La confédération Kenleur",
      "ordre": 2,
      "publie": true,
      "corps": "Kenleur est la confédération de danse bretonne à laquelle notre cercle est affilié (siège à Auray, 8 salariés).\n\nLa confédération permet aux cercles adhérents de bénéficier de formations et stages (danses, broderies, chants, histoires…), de répartir les cercles sur les événements de la saison, d'organiser l'accueil, de veiller au respect de la tradition et d'encourager la créativité via les concours (danses, costumes, spectacles scéniques).\n\nSite : kenleur.bzh",
      "medias": [],
      "createdAt": "2026-08-01T10:00:00.000Z",
      "updatedAt": "2026-08-01T10:00:00.000Z"
    },
    {
      "id": "page-notre-cercle",
